# 可以直接用後端安裝完印出的指令（加 --save 會自動寫進這裡），或手動填

# 暫存區：卡片先複製到這裡，處理完可用 --cleanup 刪掉
STAGING_DIR=~/PhotoReturnStaging

# 返圖站後端與上傳 token
SERVER_URL=
UPLOAD_TOKEN=
UPLOAD_WORKERS=3

# NAS 備份位置：smb://帳號@NAS_IP/共用資料夾/子資料夾（留空則不備份）
# 密碼放 ~/Library/Preferences/nsmb.conf（同 Prism）就不用每次輸入
NAS_SMB=
# 共用資料夾沒被掛載時，自動掛到這裡
NAS_MOUNT=~/mnt/PhotoReturnNAS

# Prism 專案位置（https://github.com/normantaipei/Prism；留空 = 和 PhotoReturn 同一層的 Prism 資料夾）
PRISM_DIR=

# Prism 參數：美學分數 -1~1 切 1~5 星的四個門檻
RATING_THRESHOLDS=0,0.4,0.55,0.7
TAG_LANG=both
TAG_MIN_CONF=0.3
TAG_TOP=12
TAG_MARKER=AI_VISION

# 返圖站也提供 RAW 下載（1=上傳 RAW，0=只傳 JPG；NAS 一律備份 RAW）
UPLOAD_RAW=1

# 人臉分組：1=每次都做（也可用 --faces / --no-faces 單次切換）
# 第一次會自動下載 InsightFace 模型（約 290 MB）；InsightFace 預訓練模型僅限非商業用途
# 人臉特徵只存在這台 Mac 的 state.db，返圖站只收到「哪幾張是同一個人」
FACES=0
# 同一人的 cosine 相似度門檻（越高越嚴格、分得越細）
FACE_THRESHOLD=0.4
# 出現少於幾張的不算一個人物（排除路人）
FACE_MIN_PHOTOS=3
# 偵測用圖（長邊 2048）上臉寬至少幾 px
FACE_MIN_PX=40
# 沒拍到臉的照片：服裝外觀相似度門檻（0~1，越高越保守）與領先第二像人物的差距
FACE_BODY_THRESHOLD=0.8
FACE_BODY_MARGIN=0.05
# 前後幾秒內都拍到同一人，中間的照片也歸給他（0 = 不用時間判斷；一邊很近時用這個的 1/5）
FACE_TIME_WINDOW=300
